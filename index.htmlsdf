import pygame
import sys

# -----------------------------
# Einstellungen
# -----------------------------
WIDTH = 1280
HEIGHT = 720
FPS = 60

pygame.init()

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Der letzte Ritter")

clock = pygame.time.Clock()

# -----------------------------
# Farben
# -----------------------------
SKY = (186, 225, 255)
GROUND = (110, 180, 90)

# -----------------------------
# Spieler
# -----------------------------
player = pygame.Rect(100, 500, 50, 70)

speed = 6
gravity = 0.8
jump_power = -16
velocity_y = 0
on_ground = False

running = True

# -----------------------------
# Hauptschleife
# -----------------------------
while running:

    clock.tick(FPS)

    # Ereignisse
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    keys = pygame.key.get_pressed()

    # Bewegung
    if keys[pygame.K_a]:
        player.x -= speed

    if keys[pygame.K_d]:
        player.x += speed

    # Springen
    if keys[pygame.K_SPACE] and on_ground:
        velocity_y = jump_power
        on_ground = False

    # Gravitation
    velocity_y += gravity
    player.y += velocity_y

    # Boden
    if player.bottom >= 650:
        player.bottom = 650
        velocity_y = 0
        on_ground = True

    # -------------------------
    # Zeichnen
    # -------------------------
    screen.fill(SKY)

    pygame.draw.rect(screen, GROUND, (0, 650, WIDTH, 70))

    # Platzhalter für den Ritter
    pygame.draw.rect(screen, (90, 90, 90), player)

    pygame.display.flip()

pygame.quit()
sys.exit()
import pygame

class Player:

    def __init__(self, x, y):

        self.image = pygame.image.load("assets/sprites/knight_idle.png").convert_alpha()

        self.rect = self.image.get_rect(topleft=(x, y))

        self.speed = 6

        self.jump_power = -16

        self.gravity = 0.8

        self.velocity_y = 0

        self.on_ground = False

        self.direction = 1

        self.current_brush = "blue"

        self.hp = 100

    def move(self, keys):

        if keys[pygame.K_a]:
            self.rect.x -= self.speed
            self.direction = -1

        if keys[pygame.K_d]:
            self.rect.x += self.speed
            self.direction = 1

        if keys[pygame.K_SPACE] and self.on_ground:
            self.velocity_y = self.jump_power
            self.on_ground = False

    def physics(self):

        self.velocity_y += self.gravity
        self.rect.y += self.velocity_y

        if self.rect.bottom >= 650:
            self.rect.bottom = 650
            self.velocity_y = 0
            self.on_ground = True

    def draw(self, screen):

        image = self.image

        if self.direction == -1:
            image = pygame.transform.flip(image, True, False)

        screen.blit(image, self.rect)
import pygame

BLUE = (60, 140, 255)
GREEN = (40, 220, 70)
RED = (230, 60, 60)

class BrushSystem:

    def __init__(self):
        self.current = "blue"
        self.lines = []

    def set_brush(self, brush):
        self.current = brush

    def paint(self, start, end):

        color = BLUE

        if self.current == "green":
            color = GREEN

        elif self.current == "red":
            color = RED

        self.lines.append({
            "start": start,
            "end": end,
            "color": color,
            "brush": self.current
        })

    def erase(self, position):

        for line in self.lines[:]:

            x1, y1 = line["start"]
            x2, y2 = line["end"]

            if abs(position[0]-x1) < 20 and abs(position[1]-y1) < 20:
                self.lines.remove(line)

    def draw(self, screen):

        for line in self.lines:

            pygame.draw.line(
                screen,
                line["color"],
                line["start"],
                line["end"],
                10
            )
import pygame


class Bridge:

    def __init__(self, start, end):

        self.start = start
        self.end = end

        self.width = 18

        self.color = (60, 140, 255)

    def draw(self, screen):

        pygame.draw.line(
            screen,
            self.color,
            self.start,
            self.end,
            self.width
        )

    def collision(self, player):

        x1, y1 = self.start
        x2, y2 = self.end

        bridge_rect = pygame.Rect(
            min(x1, x2),
            min(y1, y2)-10,
            abs(x2-x1),
            20
        )

        return player.colliderect(bridge_rect)



class BridgeManager:

    def __init__(self):

        self.bridges = []


    def create_bridge(self, start, end):

        bridge = Bridge(start, end)

        self.bridges.append(bridge)


    def remove_bridge(self, mouse_pos):

        for bridge in self.bridges[:]:

            if pygame.Rect(
                bridge.start[0]-20,
                bridge.start[1]-20,
                40,
                40
            ).collidepoint(mouse_pos):

                self.bridges.remove(bridge)


    def draw(self, screen):

        for bridge in self.bridges:

            bridge.draw(screen)
import pygame
import math


class Enemy:

    def __init__(self, x, y):

        self.image = pygame.image.load(
            "assets/sprites/monster.png"
        ).convert_alpha()

        self.rect = self.image.get_rect(
            center=(x, y)
        )

        self.speed = 2

        self.hp = 50

        self.damage = 10

        self.attack_distance = 60


    def update(self, player):

        dx = player.rect.centerx - self.rect.centerx
        dy = player.rect.centery - self.rect.centery

        distance = math.sqrt(dx*dx + dy*dy)

        if distance > self.attack_distance:

            if dx > 0:
                self.rect.x += self.speed

            else:
                self.rect.x -= self.speed


    def attack(self, player):

        if self.rect.colliderect(player.rect):

            player.hp -= self.damage


    def hit(self, damage):

        self.hp -= damage


    def dead(self):

        return self.hp <= 0


    def draw(self, screen):

        screen.blit(
            self.image,
            self.rect
        )



class EnemyManager:

    def __init__(self):

        self.enemies = []


    def add_enemy(self, x, y):

        self.enemies.append(
            Enemy(x, y)
        )


    def update(self, player):

        for enemy in self.enemies[:]:

            enemy.update(player)

            enemy.attack(player)

            if enemy.dead():

                self.enemies.remove(enemy)


    def green_attack(self, player):

        attack_area = pygame.Rect(
            player.rect.centerx-80,
            player.rect.centery-50,
            160,
            100
        )


        for enemy in self.enemies[:]:

            if attack_area.colliderect(enemy.rect):

                enemy.hit(50)


    def draw(self, screen):

        for enemy in self.enemies:

            enemy.draw(screen)
import pygame


class Ravine:

    def __init__(self, x, width):

        self.rect = pygame.Rect(
            x,
            600,
            width,
            120
        )


    def draw(self, screen):

        pygame.draw.rect(
            screen,
            (40, 30, 50),
            self.rect
        )



class Village:

    def __init__(self, x, y):

        self.rect = pygame.Rect(
            x,
            y,
            150,
            100
        )


    def draw(self, screen):

        # Haus
        pygame.draw.rect(
            screen,
            (180,120,70),
            self.rect
        )

        # Dach
        pygame.draw.polygon(
            screen,
            (120,40,40),
            [
                (self.rect.left-20,self.rect.top),
                (self.rect.centerx,self.rect.top-80),
                (self.rect.right+20,self.rect.top)
            ]
        )


    def reached(self, player):

        return self.rect.colliderect(player.rect)



class World:

    def __init__(self):

        self.ground_y = 650


        self.ravines = [

            Ravine(450,150),

            Ravine(900,180)

        ]


        self.village = Village(
            1150,
            550
        )



    def collision(self, player, bridges):


        # normale Ravinen prüfen

        for ravine in self.ravines:

            if player.rect.colliderect(ravine.rect):

                # prüfen ob eine Brücke existiert

                safe = False

                for bridge in bridges.bridges:

                    if bridge.collision(player):

                        safe = True


                if not safe:

                    player.hp = 0



    def draw(self, screen):

        # Boden

        pygame.draw.rect(
            screen,
            (80,170,80),
            (0,650,1280,70)
        )


        # Ravinen

        for ravine in self.ravines:

            ravine.draw(screen)


        # Dorf

        self.village.draw(screen)
import pygame
import sys

from player import Player
from brushes import BrushSystem
from enemies import EnemyManager
from bridge import BridgeManager
from world import World


pygame.init()


WIDTH = 1280
HEIGHT = 720
FPS = 60


screen = pygame.display.set_mode(
    (WIDTH, HEIGHT)
)

pygame.display.set_caption(
    "Der letzte Ritter - Die Heimkehr"
)


clock = pygame.time.Clock()


# ---------------------
# Spielobjekte
# ---------------------

player = Player(
    100,
    500
)


brushes = BrushSystem()

bridges = BridgeManager()

enemies = EnemyManager()

world = World()



# Monster

enemies.add_enemy(
    700,
    580
)

enemies.add_enemy(
    950,
    580
)



last_mouse = None

game_over = False

win = False



# ---------------------
# Hauptschleife
# ---------------------

running = True


while running:


    clock.tick(FPS)



    for event in pygame.event.get():


        if event.type == pygame.QUIT:

            running = False



        if event.type == pygame.KEYDOWN:


            # Pinsel wechseln

            if event.key == pygame.K_1:

                brushes.set_brush(
                    "blue"
                )


            if event.key == pygame.K_2:

                brushes.set_brush(
                    "green"
                )


            if event.key == pygame.K_3:

                brushes.set_brush(
                    "red"
                )


            # Angriff

            if event.key == pygame.K_e:

                enemies.green_attack(
                    player
                )



        if event.type == pygame.MOUSEBUTTONDOWN:


            if brushes.current == "red":

                bridges.remove_bridge(
                    pygame.mouse.get_pos()
                )



    if not game_over and not win:


        keys = pygame.key.get_pressed()



        # Ritter

        player.move(keys)

        player.physics()



        # Malen

        mouse = pygame.mouse.get_pos()


        if keys[pygame.K_q]:


            if last_mouse:


                if brushes.current == "blue":


                    bridges.create_bridge(
                        last_mouse,
                        mouse
                    )


                else:


                    brushes.paint(
                        last_mouse,
                        mouse
                    )


            last_mouse = mouse


        else:

            last_mouse = None



        # Welt

        world.collision(
            player,
            bridges
        )



        # Monster

        enemies.update(
            player
        )



        # Sieg

        if world.village.reached(player):

            win = True



        # Tod

        if player.hp <= 0:

            game_over = True




    # ---------------------
    # Zeichnen
    # ---------------------

    screen.fill(
        (180,220,255)
    )



    world.draw(
        screen
    )


    bridges.draw(
        screen
    )


    brushes.draw(
        screen
    )


    enemies.draw(
        screen
    )


    player.draw(
        screen
    )



    # Meldungen

    font = pygame.font.SysFont(
        None,
        60
    )


    if game_over:

        text = font.render(
            "Der Ritter ist gefallen!",
            True,
            (200,0,0)
        )

        screen.blit(
            text,
            (300,300)
        )



    if win:

        text = font.render(
            "Das Heimatdorf!",
            True,
            (0,150,0)
        )

        screen.blit(
            text,
            (400,300)
        )



    pygame.display.flip()



pygame.quit()

sys.exit()
import pygame


class AudioManager:

    def __init__(self):

        pygame.mixer.init()


        # Musik

        self.music = "assets/audio/background.mp3"


        # Sounds

        self.paint_sound = pygame.mixer.Sound(
            "assets/audio/paint.wav"
        )

        self.attack_sound = pygame.mixer.Sound(
            "assets/audio/attack.wav"
        )

        self.hit_sound = pygame.mixer.Sound(
            "assets/audio/hit.wav"
        )

        self.win_sound = pygame.mixer.Sound(
            "assets/audio/village.wav"
        )

        self.lose_sound = pygame.mixer.Sound(
            "assets/audio/death.wav"
        )


    def play_music(self):

        pygame.mixer.music.load(
            self.music
        )

        pygame.mixer.music.play(
            -1
        )


    def paint(self):

        self.paint_sound.play()


    def attack(self):

        self.attack_sound.play()


    def hit(self):

        self.hit_sound.play()


    def win(self):

        pygame.mixer.music.stop()

        self.win_sound.play()


    def lose(self):

        pygame.mixer.music.stop()

        self.lose_sound.play()
import pygame
import random


class PaintParticle:

    def __init__(self, x, y, color):

        self.x = x
        self.y = y

        self.color = color

        self.size = random.randint(4, 12)

        self.speed_x = random.uniform(-3,3)

        self.speed_y = random.uniform(-3,3)

        self.life = 40



    def update(self):

        self.x += self.speed_x

        self.y += self.speed_y

        self.life -= 1



    def draw(self, screen):

        pygame.draw.circle(
            screen,
            self.color,
            (
                int(self.x),
                int(self.y)
            ),
            self.size
        )



class EffectManager:


    def __init__(self):

        self.particles = []



    def paint_effect(self, pos, color):

        for i in range(8):

            self.particles.append(

                PaintParticle(
                    pos[0],
                    pos[1],
                    color
                )

            )



    def attack_effect(self, pos):

        green = (
            40,
            255,
            80
        )


        for i in range(20):

            self.particles.append(

                PaintParticle(
                    pos[0],
                    pos[1],
                    green
                )

            )



    def update(self):

        for particle in self.particles[:]:

            particle.update()


            if particle.life <= 0:

                self.particles.remove(
                    particle
                )



    def draw(self, screen):

        for particle in self.particles:

            particle.draw(screen)
import pygame


class HealthBar:

    def __init__(self):

        self.width = 300
        self.height = 30


    def draw(self, screen, hp, max_hp):

        # Position
        x = 30
        y = 30


        # Hintergrund (leer)
        pygame.draw.rect(
            screen,
            (80, 20, 20),
            (
                x,
                y,
                self.width,
                self.height
            )
        )


        # aktuelles Leben

        health_width = (
            hp / max_hp
        ) * self.width


        pygame.draw.rect(
            screen,
            (40, 220, 70),
            (
                x,
                y,
                health_width,
                self.height
            )
        )


        # Rahmen

        pygame.draw.rect(
            screen,
            (0,0,0),
            (
                x,
                y,
                self.width,
                self.height
            ),
            3
        )
def draw(self, screen):

    # Monster zeichnen

    screen.blit(
        self.image,
        self.rect
    )


    # Lebensbalken

    bar_width = 60
    bar_height = 8


    health_percent = self.hp / 50


    # roter Hintergrund

    pygame.draw.rect(
        screen,
        (120, 20, 20),
        (
            self.rect.x,
            self.rect.y - 15,
            bar_width,
            bar_height
        )
    )


    # grünes Leben

    pygame.draw.rect(
        screen,
        (30, 220, 50),
        (
            self.rect.x,
            self.rect.y - 15,
            bar_width * health_percent,
            bar_height
        )
import pygame


class Camera:

    def __init__(self, width, height):

        self.camera = pygame.Rect(
            0,
            0,
            width,
            height
        )

        self.width = width
        self.height = height



    def update(self, target):

        x = (
            target.rect.centerx
            - self.width // 2
        )

        y = (
            target.rect.centery
            - self.height // 2
        )


        self.camera = pygame.Rect(
            x,
            y,
            self.width,
            self.height
        )



    def apply(self, entity):

        return entity.rect.move(
            -self.camera.x,
            -self.camera.y
        )



    def apply_position(self, position):

        return (
            position[0] - self.camera.x,
            position[1] - self.camera.y
        ))
import pygame


class Level:


    def __init__(self):

        # Startposition Ritter

        self.player_start = (
            200,
            500
        )


        # Monster im Level

        self.enemies = [

            (700, 580),

            (950, 580),

            (1300,580),

            (1600,580)

        ]


        # Ravinen

        self.ravines = [

            pygame.Rect(
                500,
                600,
                180,
                120
            ),

            pygame.Rect(
                1100,
                600,
                200,
                120
            ),

            pygame.Rect(
                1800,
                600,
                250,
                120
            )

        ]


        # Heimatdorf

        self.village = pygame.Rect(

            2300,
            500,

            200,

            150

        )



    def draw(self, screen, camera):


        # Boden

        pygame.draw.rect(

            screen,

            (80,170,80),

            (
                -camera.camera.x,
                650-camera.camera.y,
                3000,
                100
            )

        )



        # Ravinen zeichnen

        for ravine in self.ravines:


            pygame.draw.rect(

                screen,

                (35,25,50),

                (
                    ravine.x-camera.camera.x,

                    ravine.y-camera.camera.y,

                    ravine.width,

                    ravine.height

                )

            )



        # Dorf

        pygame.draw.rect(

            screen,

            (180,120,70),

            (

                self.village.x-camera.camera.x,

                self.village.y-camera.camera.y,

                self.village.width,

                self.village.height

            )

        )



    def check_victory(self, player):

        return player.rect.colliderect(
            self.village
        )
import pygame
import os


class Assets:


    def __init__(self):

        self.path = "assets/sprites/"


        self.images = {}


        self.load_images()



    def load_images(self):

        files = {

            "knight":
            "knight_idle.png",

            "monster":
            "monster.png",

            "tree":
            "tree.png",

            "village":
            "village.png",

            "ground":
            "ground.png"

        }


        for name, file in files.items():

            full_path = os.path.join(
                self.path,
                file
            )


            try:

                image = pygame.image.load(
                    full_path
                ).convert_alpha()


                self.images[name] = image


            except:

                print(
                    "Grafik fehlt:",
                    full_path
                )



    def get(self, name):

        return self.images.get(
            name
        )
import pygame


class Background:


    def __init__(self):

        self.clouds = [

            [200,80],
            [600,120],
            [1000,60]

        ]


        self.trees = [

            [300,500],
            [800,520],
            [1400,480],
            [1900,510]

        ]



    def update(self, camera):

        self.camera_x = camera.camera.x



    def draw(self, screen):


        # Himmel

        screen.fill(
            (170,220,255)
        )


        # Wolken (bewegen langsam)

        for cloud in self.clouds:


            x = cloud[0] - self.camera_x * 0.2

            y = cloud[1]


            pygame.draw.ellipse(

                screen,

                (255,255,255),

                (
                    x,
                    y,
                    120,
                    50
                )

            )



        # Berge hinten

        pygame.draw.polygon(

            screen,

            (130,170,190),

            [

                (0,500),

                (300,250),

                (600,500),

                (900,220),

                (1300,500),

                (1600,280),

                (2000,500)

            ]

        )



        # Bäume vorne

        for tree in self.trees:


            x = tree[0] - self.camera_x


            pygame.draw.rect(

                screen,

                (90,60,30),

                (
                    x,
                    tree[1],
                    30,
                    120
                )

            )


            pygame.draw.circle(

                screen,

                (40,160,70),

                (
                    x+15,
                    tree[1]
                ),

                60

            )
import pygame
import random


BLUE = (50,140,255)
GREEN = (40,220,80)
RED = (240,50,50)


class PaintStroke:


    def __init__(self, start, end, color):

        self.start = start
        self.end = end
        self.color = color

        self.width = random.randint(
            8,
            16
        )



    def draw(self, screen, camera):

        start = (
            self.start[0]-camera.camera.x,
            self.start[1]-camera.camera.y
        )

        end = (
            self.end[0]-camera.camera.x,
            self.end[1]-camera.camera.y
        )


        pygame.draw.line(

            screen,

            self.color,

            start,

            end,

            self.width

        )


        # kleine Farbkleckse

        pygame.draw.circle(

            screen,

            self.color,

            end,

            self.width//2

        )





class BrushSystem:


    def __init__(self):

        self.current = "blue"

        self.strokes = []



    def set_brush(self, brush):

        self.current = brush



    def get_color(self):

        if self.current == "blue":

            return BLUE


        if self.current == "green":

            return GREEN


        return RED




    def paint(self,start,end):


        stroke = PaintStroke(

            start,

            end,

            self.get_color()

        )


        self.strokes.append(
            stroke
        )




    def erase(self, position):


        for stroke in self.strokes[:]:


            distance = pygame.Vector2(
                position
            ).distance_to(

                pygame.Vector2(
                    stroke.end
                )

            )


            if distance < 40:

                self.strokes.remove(
                    stroke
                )




    def draw(self,screen,camera):


        for stroke in self.strokes:

            stroke.draw(
                screen,
                camera
            )
